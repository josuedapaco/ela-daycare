# =========================================================
# Resend — https://resend.com
# =========================================================

# Tu API key (empieza con re_)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Remitente. TIENE que estar verificado en Resend.
# Opción A (para probar rápido, sin dominio verificado):
#   MAIL_FROM="ELA Daycare <onboarding@resend.dev>"
#   Con esto solo se puede enviar al correo con el que creaste tu cuenta de Resend.
#   Sirve para que TE llegue la notificación, pero NO se le mandará la confirmación al padre.
#
# Opción B (recomendada, cuando verifiques tu dominio en https://resend.com/domains):
#   MAIL_FROM="ELA Daycare <hola@eladaycare.com>"
#   Con esto se manda a cualquier correo, incluido el del padre que llenó el formulario.
MAIL_FROM="ELA Daycare <onboarding@resend.dev>"

# A dónde te llega la notificación de nuevas solicitudes
MAIL_TO=fannytorres1979@gmail.com

# (Opcional) Reply-To fijo. Si se deja vacío, cuando respondas la notificación
# el correo saldrá directo al padre que hizo la solicitud.
# MAIL_REPLY_TO=fannytorres1979@gmail.com

# Puerto del server (EasyPanel/Docker debe exponer este)
PORT=82

# =========================================================
# Panel de cupos — /panel?t=TOKEN
# =========================================================

# La llave del panel donde la dueña ajusta los cupos.
# Genera una así:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# El link que se le manda a la dueña es:  https://eladaycare.com/panel?t=EL_TOKEN
# Si lo dejas vacío, el server genera uno temporal al arrancar y lo imprime en los logs
# (se pierde en cada reinicio, así que en producción SIEMPRE ponlo aquí).
ADMIN_TOKEN=

# Dónde se guarda vacancies.json. En Docker debe ser una carpeta persistente
# (volumen), si no los cupos se pierden en cada deploy.
DATA_DIR=/app/data

# URL pública del sitio — solo se usa para imprimir el link del panel en los logs
PUBLIC_SITE_URL=https://eladaycare.com
