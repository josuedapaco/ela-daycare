# === Resend ===
# API key desde https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Remitente. Debe estar VERIFICADO en Resend (dominios verificados en https://resend.com/domains).
# Mientras no tengas dominio verificado puedes usar el sandbox de pruebas:
#   MAIL_FROM="ELA Daycare <onboarding@resend.dev>"
MAIL_FROM="ELA Daycare <hola@eladaycare.com>"

# Destinatarios (separados por coma si son varios). Aquí llegan los leads.
MAIL_TO=hola@eladaycare.com

# (Opcional) Reply-To fijo. Si se deja vacío, el reply-to será el correo del interesado.
# MAIL_REPLY_TO=hola@eladaycare.com

# Puerto del servidor Node. EasyPanel debe exponer este mismo.
PORT=3000
