# =========================================================
# Resend — https://resend.com
# =========================================================

# Tu API key (empieza con re_)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Remitente. TIENE que estar verificado en Resend.
# Opción A (para probar rapido, sin dominio verificado):
#   MAIL_FROM="ELA Daycare <onboarding@resend.dev>"
#   Con esto solo se puede enviar al correo con el que creaste tu cuenta de Resend.
#   Sirve para que TE llegue la notificación, pero NO se le mandará la confirmación al padre.
#
# Opción B (recomendada, cuando verifiques tu dominio en https://resend.com/domains):
#   MAIL_FROM="ELA Daycare <hola@eladaycare.com>"
#   Con esto se manda a cualquier correo, incluido el del padre que llenó el formulario.
MAIL_FROM="ELA Daycare <onboarding@resend.dev>"

# A dónde te llega la notificación de nuevas solicitudes
MAIL_TO=josueriera23@gmail.com

# (Opcional) Reply-To fijo. Si se deja vacío, cuando respondas la notificación
# el correo saldrá directo al padre que hizo la solicitud.
# MAIL_REPLY_TO=josueriera23@gmail.com

# Puerto del server (EasyPanel/Docker debe exponer este)
PORT=82
