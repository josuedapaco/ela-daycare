---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
}

const {
  title = "ELA Daycare — Emanuel's Little Angels Family Group Daycare en Woodhaven, Queens NY",
  description = "Emanuel's Little Angels: group family daycare licenciado en Woodhaven, Queens. Máximo 12 niños, de 6 semanas a 12 años. Aceptamos 3-K y vales de ACS/HRA. Bilingüe español e inglés.",
  image = "/img/hero/sala-principal.webp",
  canonical,
} = Astro.props;

const site = Astro.site?.origin ?? "https://eladaycare.com";
const canonicalURL = canonical ?? new URL(Astro.url.pathname, site).toString();
const imageURL = image.startsWith("http") ? image : new URL(image, site).toString();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ChildCare",
  name: "Emanuel's Little Angels Family Group Daycare",
  alternateName: "ELA Daycare",
  description:
    "Group family daycare bilingüe con licencia OCFS en Woodhaven, Queens. 6 semanas a 12 años. Acepta 3-K, ACS y HRA.",
  url: site,
  image: imageURL,
  telephone: "+1-347-369-0961",
  email: "fannytorres1979@gmail.com",
  priceRange: "$$",
  founder: { "@type": "Person", name: "Fanny" },
  address: {
    "@type": "PostalAddress",
    streetAddress: "74-18 87 Ave",
    addressLocality: "Woodhaven",
    addressRegion: "NY",
    postalCode: "11421",
    addressCountry: "US",
  },
  areaServed: [
    { "@type": "City", name: "Woodhaven" },
    { "@type": "City", name: "Ozone Park" },
    { "@type": "City", name: "Richmond Hill" },
    { "@type": "City", name: "Glendale" },
  ],
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    opens: "07:30",
    closes: "17:30",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "4.9",
    reviewCount: "34",
  },
  hasCredential: [
    { "@type": "EducationalOccupationalCredential", name: "NY OCFS License #948701" },
    { "@type": "EducationalOccupationalCredential", name: "Pediatric CPR & First Aid" },
  ],
  inLanguage: ["es", "en"],
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="ELA Daycare" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:width" content="1300" />
<meta property="og:image:height" content="975" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:locale" content="es_US" />
<meta property="og:locale:alternate" content="en_US" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

<meta name="theme-color" content="#2f73b5" />
<meta name="format-detection" content="telephone=no" />
<meta name="robots" content="index,follow,max-image-preview:large" />
<meta name="geo.region" content="US-NY" />
<meta name="geo.placename" content="Woodhaven, Queens, New York" />
<meta name="geo.position" content="40.6905;-73.8590" />
<meta name="ICBM" content="40.6905, -73.8590" />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
