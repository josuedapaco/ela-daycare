---
// Orbes suaves flotando detrás del hero. Muy sutil: no compite con el contenido.
// Oculto en móvil (<=900px) para no cargar la escena innecesariamente.
---

<canvas id="hero-three" aria-hidden="true"></canvas>

<style>
  #hero-three{
    position:absolute;inset:0;width:100%;height:100%;
    pointer-events:none;z-index:0;
    opacity:0;
    filter:blur(28px) saturate(1.15);
    transition:opacity 1.2s ease;
    mix-blend-mode:multiply;
  }
  #hero-three.ready{opacity:.55}
  .hero{position:relative;overflow:hidden}
  .hero .wrap{position:relative;z-index:1}
  @media(max-width:900px){ #hero-three{display:none} }
  @media(prefers-reduced-motion:reduce){ #hero-three{display:none} }
</style>

<script>
  import * as THREE from 'three';

  const canvas = document.getElementById('hero-three') as HTMLCanvasElement | null;
  const media = window.matchMedia('(max-width: 900px), (prefers-reduced-motion: reduce)');

  if (canvas && !media.matches) {
    const parent = canvas.parentElement as HTMLElement;

    const scene = new THREE.Scene();
    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: false });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));

    const camera = new THREE.PerspectiveCamera(50, 1, 0.1, 100);
    camera.position.z = 8;

    // Orbes: esferas grandes, sin sombreado duro, translúcidas.
    // Colores pastel MUY suaves — refuerzan la paleta sin gritar.
    const palette = [
      new THREE.Color('#9AD3F0'), // sky pastel
      new THREE.Color('#B9E3D8'), // teal pastel
      new THREE.Color('#FFD9B0'), // yellow pastel cálido
      new THREE.Color('#FFC9BE'), // coral pastel
    ];

    type Orb = { mesh: THREE.Mesh; base: THREE.Vector3; speed: number; phase: number; drift: number };
    const orbs: Orb[] = [];

    const geo = new THREE.SphereGeometry(2, 32, 24);
    for (let i = 0; i < 4; i++) {
      const mat = new THREE.MeshBasicMaterial({
        color: palette[i],
        transparent: true,
        opacity: 0.45,
      });
      const mesh = new THREE.Mesh(geo, mat);
      const angle = (i / 4) * Math.PI * 2 + Math.random() * 0.4;
      const radius = 3.6 + Math.random() * 1.4;
      const base = new THREE.Vector3(Math.cos(angle) * radius, Math.sin(angle) * radius * 0.65, -1 - Math.random() * 2);
      mesh.position.copy(base);
      const s = 0.9 + Math.random() * 0.5;
      mesh.scale.setScalar(s);
      scene.add(mesh);
      orbs.push({
        mesh,
        base,
        speed: 0.06 + Math.random() * 0.08, // MUY lento
        phase: Math.random() * Math.PI * 2,
        drift: 0.4 + Math.random() * 0.3,
      });
    }

    function resize() {
      const w = parent.clientWidth;
      const h = parent.clientHeight;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    }
    resize();
    requestAnimationFrame(() => canvas.classList.add('ready'));

    const ro = new ResizeObserver(resize);
    ro.observe(parent);

    let running = true;
    document.addEventListener('visibilitychange', () => {
      running = !document.hidden;
      if (running) requestAnimationFrame(tick);
    });

    function tick(t: number) {
      if (!running) return;
      const time = t * 0.001;
      orbs.forEach((o) => {
        o.mesh.position.x = o.base.x + Math.sin(time * o.speed + o.phase) * o.drift;
        o.mesh.position.y = o.base.y + Math.cos(time * o.speed * 0.85 + o.phase) * o.drift;
      });
      renderer.render(scene, camera);
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }
</script>
