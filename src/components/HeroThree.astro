---
// Fondo Three.js: cubos, esferas y estrellas flotantes en los colores de la marca.
// Se carga en cliente, respeta prefers-reduced-motion, pausa cuando la pestaña no está visible.
---

<canvas id="hero-three" aria-hidden="true"></canvas>

<style>
  #hero-three{
    position:absolute;inset:0;width:100%;height:100%;
    pointer-events:none;z-index:0;
    opacity:0;transition:opacity .8s ease;
  }
  #hero-three.ready{opacity:.7}
  .hero{position:relative}
  .hero .wrap{position:relative;z-index:1}
  @media(prefers-reduced-motion:reduce){
    #hero-three{display:none}
  }
</style>

<script>
  import * as THREE from 'three';

  const canvas = document.getElementById('hero-three') as HTMLCanvasElement | null;
  if (canvas && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const parent = canvas.parentElement as HTMLElement;

    const scene = new THREE.Scene();
    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    const camera = new THREE.PerspectiveCamera(55, 1, 0.1, 100);
    camera.position.z = 8;

    const dir = new THREE.DirectionalLight(0xffffff, 1.4);
    dir.position.set(4, 5, 6);
    scene.add(dir);
    scene.add(new THREE.AmbientLight(0xffffff, 0.55));

    type Piece = { mesh: THREE.Mesh; rot: THREE.Vector3; float: number; phase: number; baseY: number };
    const pieces: Piece[] = [];

    const palette = [0x8EC5F6, 0x7CCDBE, 0xFFD166, 0xFFB5A7];

    function makeStar(): THREE.BufferGeometry {
      const shape = new THREE.Shape();
      const outer = 0.9, inner = 0.4, points = 5;
      for (let i = 0; i < points * 2; i++) {
        const r = i % 2 === 0 ? outer : inner;
        const a = (i / (points * 2)) * Math.PI * 2 - Math.PI / 2;
        const x = Math.cos(a) * r, y = Math.sin(a) * r;
        if (i === 0) shape.moveTo(x, y); else shape.lineTo(x, y);
      }
      return new THREE.ExtrudeGeometry(shape, { depth: 0.35, bevelEnabled: true, bevelSize: 0.06, bevelThickness: 0.06, bevelSegments: 2 });
    }

    const geos: THREE.BufferGeometry[] = [
      new THREE.BoxGeometry(1, 1, 1),
      new THREE.SphereGeometry(0.7, 32, 24),
      new THREE.TorusGeometry(0.55, 0.22, 20, 40),
      makeStar(),
      new THREE.IcosahedronGeometry(0.75, 0),
    ];

    for (let i = 0; i < 9; i++) {
      const geo = geos[i % geos.length];
      const mat = new THREE.MeshStandardMaterial({
        color: palette[i % palette.length],
        roughness: 0.55,
        metalness: 0.1,
        flatShading: true,
        transparent: true,
        opacity: 0.92,
      });
      const mesh = new THREE.Mesh(geo, mat);
      const x = (Math.random() - 0.5) * 12;
      const y = (Math.random() - 0.5) * 6.5;
      const z = -Math.random() * 4;
      mesh.position.set(x, y, z);
      const s = 0.55 + Math.random() * 0.55;
      mesh.scale.setScalar(s);
      mesh.rotation.set(Math.random() * Math.PI, Math.random() * Math.PI, Math.random() * Math.PI);
      scene.add(mesh);
      pieces.push({
        mesh,
        rot: new THREE.Vector3((Math.random() - 0.5) * 0.4, (Math.random() - 0.5) * 0.5, (Math.random() - 0.5) * 0.3),
        float: 0.4 + Math.random() * 0.6,
        phase: Math.random() * Math.PI * 2,
        baseY: y,
      });
    }

    function resize() {
      const w = parent.clientWidth;
      const h = parent.clientHeight;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    }
    resize();
    canvas.classList.add('ready');

    const ro = new ResizeObserver(resize);
    ro.observe(parent);

    let mouseX = 0, mouseY = 0;
    window.addEventListener('pointermove', (e) => {
      mouseX = (e.clientX / window.innerWidth) * 2 - 1;
      mouseY = (e.clientY / window.innerHeight) * 2 - 1;
    }, { passive: true });

    let running = true;
    document.addEventListener('visibilitychange', () => {
      running = !document.hidden;
      if (running) tick(performance.now());
    });

    function tick(t: number) {
      if (!running) return;
      const time = t * 0.001;
      pieces.forEach((p) => {
        p.mesh.rotation.x += p.rot.x * 0.008;
        p.mesh.rotation.y += p.rot.y * 0.008;
        p.mesh.rotation.z += p.rot.z * 0.008;
        p.mesh.position.y = p.baseY + Math.sin(time * p.float + p.phase) * 0.35;
      });
      camera.position.x += (mouseX * 0.7 - camera.position.x) * 0.05;
      camera.position.y += (-mouseY * 0.5 - camera.position.y) * 0.05;
      camera.lookAt(0, 0, 0);
      renderer.render(scene, camera);
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }
</script>
