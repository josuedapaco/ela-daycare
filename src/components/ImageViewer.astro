<dialog class="image-viewer" aria-label="Vista ampliada de la foto">
  <button class="image-viewer-close" type="button" aria-label="Cerrar imagen">×</button>
  <figure>
    <img class="image-viewer-photo" alt="" />
    <figcaption class="image-viewer-caption"></figcaption>
  </figure>
</dialog>
<script>
  const viewer = document.querySelector<HTMLDialogElement>('.image-viewer')!;
  const photo = viewer.querySelector<HTMLImageElement>('.image-viewer-photo')!;
  const caption = viewer.querySelector<HTMLElement>('.image-viewer-caption')!;
  const close = viewer.querySelector<HTMLButtonElement>('.image-viewer-close')!;
  let source: HTMLElement | null = null;
  let scrollY = 0;
  let overflow = '';
  const openPhoto = (img: HTMLImageElement, trigger: HTMLElement) => {
    if (viewer.open) return;
    source = trigger;
    scrollY = window.scrollY;
    overflow = document.documentElement.style.overflow;
    photo.src = img.currentSrc || img.src;
    photo.alt = img.alt;
    caption.textContent = img.alt;
    const english = document.documentElement.lang.startsWith('en');
    viewer.setAttribute('aria-label', english ? 'Enlarged photo' : 'Vista ampliada de la foto');
    close.setAttribute('aria-label', english ? 'Close image' : 'Cerrar imagen');
    viewer.showModal();
    document.documentElement.style.overflow = 'hidden';
  };
  document.querySelectorAll<HTMLImageElement>('.frame > img:not(.carousel-slide)').forEach((img) => {
    const link = document.createElement('a');
    link.href = img.src;
    link.className = 'photo-expand';
    link.setAttribute('aria-label', `Ver foto: ${img.alt}`);
    img.before(link);
    link.append(img);
  });
  document.querySelectorAll<HTMLAnchorElement>('.photo-expand, .photo-collage a').forEach((link) => {
    link.addEventListener('click', (event) => {
      if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      const img = link.querySelector('img');
      if (img) { event.preventDefault(); openPhoto(img, link); }
    });
  });
  document.querySelectorAll<HTMLElement>('.carousel-frame').forEach((frame) => {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'carousel-expand';
    button.setAttribute('aria-label', 'Ampliar foto / Enlarge photo');
    button.addEventListener('click', () => {
      const img = frame.querySelector<HTMLImageElement>('.carousel-slide.active');
      if (img) openPhoto(img, button);
    });
    frame.append(button);
  });
  close.addEventListener('click', () => viewer.close());
  viewer.addEventListener('click', (event) => { if (event.target === viewer) viewer.close(); });
  viewer.addEventListener('close', () => {
    document.documentElement.style.overflow = overflow;
    source?.focus({ preventScroll: true });
    window.scrollTo({ top: scrollY, behavior: 'instant' });
    photo.removeAttribute('src');
  });
</script>
<style is:global>
  .photo-expand{display:block;width:100%;height:100%;cursor:zoom-in}
  .frame>.photo-expand>img{width:100%;height:100%;object-fit:cover;border-radius:inherit}
  .frame>.photo-expand>img[src*="fanny"]{object-position:center 22%}
  .frame>.photo-expand>img[src*="duena"]{object-position:65% center}
  .photo-expand:focus-visible,.carousel-expand:focus-visible{outline:3px solid var(--sky-dk);outline-offset:-4px}
  .carousel-expand{position:absolute;inset:0;z-index:2;width:100%;height:100%;border:0;background:transparent;cursor:zoom-in}
  .image-viewer{position:fixed;inset:0;width:100%;max-width:none;height:100%;max-height:none;margin:0;padding:60px 20px 24px;border:0;background:rgba(10,20,30,.94);color:#fff;box-sizing:border-box;overflow:auto}
  .image-viewer::backdrop{background:rgba(10,20,30,.7)}
  .image-viewer[open]{display:flex;align-items:center;justify-content:center}
  .image-viewer figure{margin:0;max-width:100%;text-align:center;pointer-events:none}
  .image-viewer-photo{width:auto;max-width:100%;height:auto;max-height:calc(100dvh - 140px);object-fit:contain;margin:auto;pointer-events:auto;border-radius:8px}
  .image-viewer-caption{font-size:14px;line-height:1.4;margin:12px auto 0;max-width:75ch}
  .image-viewer-close{position:fixed;top:calc(12px + env(safe-area-inset-top));right:max(14px,env(safe-area-inset-right));width:46px;height:46px;border:1px solid #ffffff70;border-radius:50%;background:#253647;color:#fff;font-size:32px;line-height:1;cursor:pointer;z-index:1}
  .image-viewer-close:focus-visible{outline:3px solid #FFD166;outline-offset:3px}
  @media(max-width:600px){.image-viewer{padding:70px 12px 20px}.image-viewer-caption{font-size:13px}}
</style>
