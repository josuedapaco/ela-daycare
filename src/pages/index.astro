---
import Base from '../layouts/Base.astro';
import MobileMenu from '../components/MobileMenu.astro';
import ConfirmDialog from '../components/ConfirmDialog.astro';
---
<Base>

<!-- ====== LOGOTIPO (definición reutilizable) ====== -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
<symbol id="ela" viewBox="0 0 200 178">
  <ellipse cx="100" cy="16" rx="27" ry="8" fill="none" stroke="#FFD166" stroke-width="7"/>
  <path d="M36 48l3.4 6.9 7.6.9-5.5 5.3 1.4 7.5-6.9-3.7-6.9 3.7 1.4-7.5-5.5-5.3 7.6-.9z" fill="#FFD166"/>
  <path d="M166 58l2.7 5.5 6 .7-4.4 4.2 1.1 6-5.4-2.9-5.4 2.9 1.1-6-4.4-4.2 6-.7z" fill="#7CCDBE"/>
  <circle cx="152" cy="36" r="5" fill="#FFB5A7"/>
  <g fill="#C9E1F8">
    <path d="M62 72C46 60 22 58 9 69c8 4 15 8 19 13-8-2-17 1-22 8 9 3 17 6 22 11-8 0-16 5-18 13 18 5 38-3 48-18 5-8 6-18 4-24Z"/>
    <path d="M138 72C154 60 178 58 191 69c-8 4-15 8-19 13 8-2 17 1 22 8-9 3-17 6-22 11 8 0 16 5 18 13-18 5-38-3-48-18-5-8-6-18-4-24Z"/>
  </g>
  <g stroke="#7CCDBE" stroke-width="8" stroke-linecap="round" fill="none">
    <path d="M89 100 74 82"/><path d="M111 100 126 82"/>
  </g>
  <path d="M52 74 100 34 148 74" fill="none" stroke="#8EC5F6" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M60 72V110" stroke="#8EC5F6" stroke-width="10" stroke-linecap="round"/>
  <path d="M140 72V110" stroke="#8EC5F6" stroke-width="10" stroke-linecap="round"/>
  <g fill="#FFD166">
    <rect x="88" y="49" width="9" height="9" rx="2.4"/><rect x="102" y="49" width="9" height="9" rx="2.4"/>
    <rect x="88" y="62" width="9" height="9" rx="2.4"/><rect x="102" y="62" width="9" height="9" rx="2.4"/>
  </g>
  <circle cx="100" cy="88" r="10.5" fill="#7CCDBE"/>
  <path d="M100 100c-8 0-13 5.5-13 13v6h26v-6c0-7.5-5-13-13-13Z" fill="#7CCDBE"/>
  <path d="M100 152c-11.5-8.5-21-14.5-21-24 0-6.6 5.3-11.5 11.5-11.5 4.3 0 7.6 2.1 9.5 5.4 1.9-3.3 5.2-5.4 9.5-5.4 6.2 0 11.5 4.9 11.5 11.5 0 9.5-9.5 15.5-21 24Z" fill="#FFB5A7"/>
</symbol>
</svg>

<!-- ====== BARRA UTILITARIA ====== -->
<div class="util">
  <div class="wrap">
    <div>
      <a href="tel:+13473690961">📞 <span class="fill">+1 (347) 369-0961</span></a>
      <span class="lic" style="margin-left:14px" data-es="Licencia OCFS de NY #" data-en="NY OCFS License #">Licencia OCFS de NY #</span><span class="lic fill">948701</span>
      <span class="lic" data-es=" · Lun a Vie 7:30am–5:30pm" data-en=" · Mon–Fri 7:30am–5:30pm"> · Lun a Vie 7:30am–5:30pm</span>
    </div>
    <div class="right">
      <button class="revbtn" id="revb" aria-pressed="false" onclick="review()" data-es="Qué falta llenar" data-en="What's still missing">Qué falta llenar</button>
      <div class="langsw" role="group" aria-label="Idioma / Language">
        <button onclick="setLang('es')" aria-pressed="true" id="b-es">Español</button>
        <button onclick="setLang('en')" aria-pressed="false" id="b-en">English</button>
      </div>
    </div>
  </div>
</div>

<!-- ====== NAV ====== -->
<nav class="main">
  <div class="wrap">
    <a class="brand" href="#top">
      <svg width="46" height="41" viewBox="0 0 200 178" aria-hidden="true"><use href="#ela"/></svg>
      <span class="brandname"><b>ELA</b> <i>Daycare</i>
        <small data-es="Emanuel's Little Angels" data-en="Emanuel's Little Angels">Emanuel's Little Angels</small>
      </span>
    </a>
    <button class="burger" onclick="window.__openMobileMenu && window.__openMobileMenu()" aria-label="Abrir menú" aria-expanded="false">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <div class="navlinks">
      <a href="#porque" data-es="Por qué una casa" data-en="Why a home">Por qué una casa</a>
      <a href="#grupos" data-es="Grupos" data-en="Groups">Grupos</a>
      <a href="#vacantes" data-es="Vacantes" data-en="Openings">Vacantes</a>
      <a href="#ayuda" data-es="3-K y vales" data-en="3-K &amp; vouchers">3-K y vales</a>
      <a href="#visita" data-es="Inscripción" data-en="Enroll">Inscripción</a>
    </div>
    <a class="btn btn-1 btn-sm" href="#visita" style="margin-left:14px" data-es="Agendar visita" data-en="Book a tour">Agendar visita</a>
    <div class="langsw-nav" role="group" aria-label="Idioma / Language">
      <button onclick="setLang('es')" aria-pressed="true" id="b2-es">ES</button>
      <button onclick="setLang('en')" aria-pressed="false" id="b2-en">EN</button>
    </div>
  </div>
</nav>

<!-- ====== HERO ====== -->
<header class="hero" id="top">
  <div class="wrap">
    <div class="grid">
      <div>
        <span class="eyebrow" data-es="✦ Cupos abiertos para otoño 2026" data-en="✦ Now enrolling for Fall 2026">✦ Cupos abiertos para otoño 2026</span>
        <h1>
          <span data-es="Los cuidamos" data-en="We care for them">Los cuidamos</span>
          <span class="hi"><span data-es="como en casa" data-en="like family">como en casa</span>
            <svg viewBox="0 0 200 13" preserveAspectRatio="none" aria-hidden="true"><path d="M2 8c40-6 90-7 196-3" stroke="#FFD166" stroke-width="5" fill="none" stroke-linecap="round"/></svg>
          </span>
          <span data-es="— porque es una casa." data-en="— because it is a home.">— porque es una casa.</span>
        </h1>
        <p class="lede"><span data-es="Emanuel's Little Angels es un group family daycare con licencia del estado en" data-en="Emanuel's Little Angels is a state-licensed group family daycare in">Emanuel's Little Angels es un group family daycare con licencia del estado en</span> <b class="fill">Jackson Heights</b><span data-es=", Queens. Máximo 12 niños, de 6 semanas a 12 años, con las mismas dos personas cada día. Bilingüe, y sí, publicamos nuestros precios." data-en=", Queens. A maximum of 12 children, ages 6 weeks to 12 years, with the same two people every day. Bilingual, and yes, we publish our prices.">, Queens. Máximo 12 niños, de 6 semanas a 12 años, con las mismas dos personas cada día. Bilingüe, y sí, publicamos nuestros precios.</span></p>
        <div class="cta-row">
          <a class="btn btn-1" href="#visita" data-es="Ver vacantes y precios" data-en="See openings &amp; pricing">Ver vacantes y precios</a>
          <a class="btn btn-2" href="#dia" data-es="Mira un día con nosotros" data-en="See a day with us">Mira un día con nosotros</a>
        </div>
        <div class="motto">
          <span class="a" data-es="Cuidar" data-en="Nurture">Cuidar</span><i class="d"></i>
          <span class="b" data-es="Proteger" data-en="Protect">Proteger</span><i class="d"></i>
          <span class="c" data-es="Crecer" data-en="Grow">Crecer</span>
        </div>
        <div class="trust">
          <span class="stars">★★★★★</span>
          <span data-es="4.9 en Google · 34 reseñas de familias del barrio" data-en="4.9 on Google · 34 reviews from local families"><span class="fill">4.9 en Google · 34 reseñas</span> de familias del barrio</span>
        </div>
      </div>
      <div class="hero-art">
        <div class="frame">
          <img src="/img/hero/sala-principal.webp" alt="La casa vista desde el patio trasero, con el porche de madera y el área de juegos infantiles" fetchpriority="high">
        </div>
        <div class="badge">
          <svg width="34" height="34" viewBox="0 0 34 34" aria-hidden="true">
            <circle cx="17" cy="17" r="17" fill="#e8f6f3"/>
            <path d="M10 17.5l4.5 4.5L24 12.5" stroke="#3a8f7e" stroke-width="3.2" fill="none" stroke-linecap="round"/>
          </svg>
          <div>
            <b data-es="Una cuidadora por cada 2 bebés" data-en="One caregiver for every 2 babies">Una cuidadora por cada 2 bebés</b>
            <small data-es="Como lo exige la licencia del estado" data-en="As required by the state license">Como lo exige la licencia del estado</small>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<!-- ====== FRANJA PRUEBA SOCIAL ====== -->
<section class="social">
  <div class="social-row">
    <div class="avatars">
      <div class="av">M</div>
      <div class="av">R</div>
      <div class="av">D</div>
      <div class="av">+</div>
    </div>
    <div class="social-txt">
      <div class="line1">
        <span class="stars">★★★★★</span>
        <b class="fill" data-es="4.9 en Google · 34 familias reseñando" data-en="4.9 on Google · 34 families reviewing">4.9 en Google · 34 familias reseñando</b>
      </div>
      <cite data-es="&laquo;Mi hija llegó de 8 meses y salió leyendo. Nos sentimos parte de otra familia.&raquo; — Mariana, mamá en Elmhurst" data-en="&laquo;My daughter arrived at 8 months and left reading. We felt like part of another family.&raquo; — Mariana, mom in Elmhurst">«Mi hija llegó de 8 meses y salió leyendo. Nos sentimos parte de otra familia.» — Mariana, mamá en Elmhurst</cite>
    </div>
  </div>
</section>

<svg class="sep" viewBox="0 0 1440 50" preserveAspectRatio="none" aria-hidden="true">
  <path fill="#fbf8f1" d="M0 30a70 25 0 0 1 120 0a70 25 0 0 1 120 0a70 25 0 0 1 120 0a70 25 0 0 1 120 0a70 25 0 0 1 120 0a70 25 0 0 1 120 0a70 25 0 0 1 120 0a70 25 0 0 1 120 0a70 25 0 0 1 120 0a70 25 0 0 1 120 0a70 25 0 0 1 120 0a70 25 0 0 1 120 0V50H0Z"/>
</svg>

<!-- ====== ESTADÍSTICAS ====== -->
<section class="band" style="padding:50px 0">
  <div class="wrap">
    <div class="stats">
      <div class="stat"><span class="stat-n">12</span><span class="stat-l" data-es="niños como máximo, nunca más" data-en="children maximum, never more">niños como máximo, nunca más</span></div>
      <div class="stat"><span class="stat-n">2</span><span class="stat-l" data-es="adultos presentes todo el día" data-en="adults present all day">adultos presentes todo el día</span></div>
      <div class="stat"><span class="stat-n">6 <small style="font-size:19px">sem</small></span><span class="stat-l" data-es="la edad más chiquita que recibimos" data-en="the youngest age we take">la edad más chiquita que recibimos</span></div>
      <div class="stat"><span class="stat-n fill">9</span><span class="stat-l" data-es="años cuidando niños en Queens" data-en="years caring for children in Queens">años cuidando niños en Queens</span></div>
    </div>
    <p style="text-align:center;margin:20px auto 0;max-width:58ch;color:var(--ink-2);font-weight:700" data-es="Un centro grande tiene 60 niños y personal que rota. Aquí son doce, siempre los mismos doce, y tu hijo puede quedarse con nosotros desde bebé hasta la escuela primaria." data-en="A big center has 60 children and staff that rotates. Here there are twelve, always the same twelve, and your child can stay with us from baby all the way through elementary school.">Un centro grande tiene 60 niños y personal que rota. Aquí son doce, siempre los mismos doce, y tu hijo puede quedarse con nosotros desde bebé hasta la escuela primaria.</p>
  </div>
</section>

<!-- ====== FRANJA DE CREDENCIALES ====== -->
<section class="creds">
  <div class="wrap">
    <div class="creds-grid">
      <div class="cred">
        <div class="cred-ico">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2f73b5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 4v6c0 5-3.5 9-8 10-4.5-1-8-5-8-10V6z"/><path d="m9 12 2 2 4-4"/></svg>
        </div>
        <b data-es="Licencia OCFS de NY" data-en="NY OCFS License">Licencia OCFS de NY</b>
        <small class="fill">#948701</small>
      </div>
      <div class="cred">
        <div class="cred-ico">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#3a8f7e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-4.3-7-9.5A4.5 4.5 0 0 1 12 8a4.5 4.5 0 0 1 7 3.5C19 16.7 12 21 12 21Z"/></svg>
        </div>
        <b data-es="CPR + primeros auxilios" data-en="CPR + first aid">CPR + primeros auxilios</b>
        <small data-es="Certificación al día" data-en="Current certification">Certificación al día</small>
      </div>
      <div class="cred">
        <div class="cred-ico">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#cf5d47" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5"/><path d="M5.5 9.5V20h13V9.5"/><path d="M10 20v-5h4v5"/></svg>
        </div>
        <b data-es="Aceptamos ACS · HRA" data-en="Accept ACS · HRA">Aceptamos ACS · HRA</b>
        <small data-es="Vales del estado" data-en="State vouchers">Vales del estado</small>
      </div>
      <div class="cred">
        <div class="cred-ico">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#a87b16" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M6 21V10l6-4 6 4v11"/><path d="M9 21v-6h6v6"/></svg>
        </div>
        <b data-es="Programa 3-K" data-en="3-K program">Programa 3-K</b>
        <small data-es="Gratis para 3 años" data-en="Free for 3-year-olds">Gratis para 3 años</small>
      </div>
      <div class="cred">
        <div class="cred-ico">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#25405c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a4 4 0 0 1 4 4v3a4 4 0 0 1-8 0V7a4 4 0 0 1 4-4z"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
        </div>
        <b data-es="Bilingüe ES · EN" data-en="Bilingual EN · ES">Bilingüe ES · EN</b>
        <small data-es="Nativo, no traducido" data-en="Native, not translated">Nativo, no traducido</small>
      </div>
    </div>
  </div>
</section>

<!-- ====== POR QUÉ UNA CASA ====== -->
<section id="porque">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow" data-es="Casa, no centro" data-en="A home, not a center">Casa, no centro</span>
      <h2><span data-es="Lo que un centro grande" data-en="What a big center">Lo que un centro grande</span> <em data-es="no te puede dar" data-en="cannot give you">no te puede dar</em></h2>
      <p data-es="Ser pequeños no es nuestra limitación: es exactamente la razón por la que las familias nos eligen." data-en="Being small isn't our limitation — it's exactly why families choose us.">Ser pequeños no es nuestra limitación: es exactamente la razón por la que las familias nos eligen.</p>
    </div>
    <div class="why">
      <div class="wcard">
        <div class="ico" style="background:var(--sky-sf)">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#2f73b5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.4"/><path d="M3 20c0-3.3 2.7-5 6-5s6 1.7 6 5"/><path d="M15.5 20c0-2.4 1.6-3.6 3.6-3.6s2.9 1.2 2.9 3.6"/></svg>
        </div>
        <h3 data-es="Los hermanos se quedan juntos" data-en="Siblings stay together">Los hermanos se quedan juntos</h3>
        <p data-es="Un bebé de 8 meses y su hermana de 6 años pasan el día en la misma casa, con las mismas personas. No hay dos rutas de transporte ni dos facturas de dos lugares distintos." data-en="An 8-month-old and his 6-year-old sister spend the day in the same house, with the same people. No two drop-offs, no two bills from two different places.">Un bebé de 8 meses y su hermana de 6 años pasan el día en la misma casa, con las mismas personas. No hay dos rutas de transporte ni dos facturas de dos lugares distintos.</p>
      </div>
      <div class="wcard">
        <div class="ico" style="background:var(--teal-sf)">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#3a8f7e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-4.3-7-9.5A4.5 4.5 0 0 1 12 8a4.5 4.5 0 0 1 7 3.5C19 16.7 12 21 12 21Z"/></svg>
        </div>
        <h3 data-es="La misma cara por años" data-en="The same face for years">La misma cara por años</h3>
        <p data-es="En un centro, cada septiembre le toca maestra nueva. Aquí tu hijo se apega a una sola persona y se queda con ella hasta que entra a la escuela. Para un niño chiquito eso vale más que cualquier currículo." data-en="At a center, every September means a new teacher. Here your child bonds with one person and stays with her until school starts. For a little one that matters more than any curriculum.">En un centro, cada septiembre le toca maestra nueva. Aquí tu hijo se apega a una sola persona y se queda con ella hasta que entra a la escuela. Para un niño chiquito eso vale más que cualquier currículo.</p>
      </div>
      <div class="wcard">
        <div class="ico" style="background:var(--coral-sf)">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#cf5d47" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5"/><path d="M5.5 9.5V20h13V9.5"/><path d="M10 20v-5h4v5"/></svg>
        </div>
        <h3 data-es="Ritmo de casa, no de escuela" data-en="A home's rhythm, not a school's">Ritmo de casa, no de escuela</h3>
        <p data-es="Se come en la mesa de la cocina, se duerme cuando da sueño y si un niño está de mal día se le carga. No hay campana que suene ni fila que hacer." data-en="They eat at the kitchen table, sleep when they're sleepy, and if a child is having a rough day, someone picks him up. No bells, no lining up.">Se come en la mesa de la cocina, se duerme cuando da sueño y si un niño está de mal día se le carga. No hay campana que suene ni fila que hacer.</p>
      </div>
    </div>
  </div>
</section>

<!-- ====== VACANTES ====== -->
<section class="band-sky" id="vacantes">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow" style="background:#fff;color:var(--sky-dk)" data-es="Actualizado cada lunes" data-en="Updated every Monday">Actualizado cada lunes</span>
      <h2><span data-es="Cupos reales," data-en="Real openings,">Cupos reales,</span> <em data-es="sin llamar a nadie" data-en="without calling anyone">sin llamar a nadie</em></h2>
      <p data-es="Con doce lugares, cada cupo cuenta. Aquí ves exactamente cuáles están libres hoy, y si hay lista de espera te decimos cuántas familias van antes que tú." data-en="With twelve spots, every one counts. Here you see exactly which are open today, and if there's a waitlist we tell you how many families are ahead of you.">Con doce lugares, cada cupo cuenta. Aquí ves exactamente cuáles están libres hoy, y si hay lista de espera te decimos cuántas familias van antes que tú.</p>
    </div>
    <div class="vac">
      <div class="vcard"><h3 data-es="Bebés" data-en="Babies">Bebés</h3>
        <div class="age" data-es="6 semanas – 18 meses" data-en="6 weeks – 18 months">6 semanas – 18 meses</div>
        <span class="pill wait"><i class="dot"></i><span class="fill" data-es="Lleno · 2 en espera" data-en="Full · 2 waiting">Lleno · 2 en espera</span></span>
        <div class="cap"><div class="cap-bar"><div class="cap-fill f-full" style="width:100%"></div></div>
          <div class="cap-txt"><span data-es="2 / 2 llenos" data-en="2 / 2 filled">2 / 2 llenos</span><span data-es="lista +2" data-en="waitlist +2">lista +2</span></div></div></div>
      <div class="vcard"><h3 data-es="Caminadores" data-en="Toddlers">Caminadores</h3>
        <div class="age" data-es="18 meses – 3 años" data-en="18 months – 3 years">18 meses – 3 años</div>
        <span class="pill few"><i class="dot"></i><span class="fill" data-es="1 cupo" data-en="1 spot left">1 cupo</span></span>
        <div class="cap"><div class="cap-bar"><div class="cap-fill f-few" style="width:66%"></div></div>
          <div class="cap-txt"><span data-es="2 / 3 llenos" data-en="2 / 3 filled">2 / 3 llenos</span><span data-es="1 disponible" data-en="1 available">1 disponible</span></div></div></div>
      <div class="vcard"><h3 data-es="Angelitos" data-en="Little Angels">Angelitos</h3>
        <div class="age" data-es="3 – 5 años · 3-K" data-en="3 – 5 years · 3-K">3 – 5 años · 3-K</div>
        <span class="pill open"><i class="dot"></i><span class="fill" data-es="3 cupos" data-en="3 spots open">3 cupos</span></span>
        <div class="cap"><div class="cap-bar"><div class="cap-fill f-open" style="width:25%"></div></div>
          <div class="cap-txt"><span data-es="1 / 4 lleno" data-en="1 / 4 filled">1 / 4 lleno</span><span data-es="3 disponibles" data-en="3 available">3 disponibles</span></div></div></div>
      <div class="vcard"><h3 data-es="Después de escuela" data-en="After school">Después de escuela</h3>
        <div class="age" data-es="5 – 12 años" data-en="5 – 12 years">5 – 12 años</div>
        <span class="pill open"><i class="dot"></i><span class="fill" data-es="4 cupos" data-en="4 spots open">4 cupos</span></span>
        <div class="cap"><div class="cap-bar"><div class="cap-fill f-open" style="width:0%"></div></div>
          <div class="cap-txt"><span data-es="0 / 4 llenos" data-en="0 / 4 filled">0 / 4 llenos</span><span data-es="4 disponibles" data-en="4 available">4 disponibles</span></div></div></div>
    </div>
    <p class="vac-note"><span data-es="Última actualización:" data-en="Last updated:">Última actualización:</span> <span class="fill" data-es="lunes 3 de agosto de 2026" data-en="Monday, August 3, 2026">lunes 3 de agosto de 2026</span>. <span data-es="Nuestra licencia permite hasta 12 niños de 6 semanas a 12 años, más cuatro niños de edad escolar." data-en="Our license allows up to 12 children ages 6 weeks to 12 years, plus four additional school-age children.">Nuestra licencia permite hasta 12 niños de 6 semanas a 12 años, más cuatro niños de edad escolar.</span></p>
